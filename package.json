{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:sync": "supabase db schema declarative sync --no-apply -f",
    "conflicts": "node scripts/reservation-conflicts.mjs",
    "test": "vitest run",
    "typecheck:calc": "tsc -p tsconfig.calc.json --noEmit",
    "test:calc": "vitest run lib/calc --coverage && npm run typecheck:calc",
    "test:calc:tz": "TZ=Pacific/Kiritimati vitest run lib/calc && TZ=America/Los_Angeles vitest run lib/calc"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.22.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "^4.10.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
