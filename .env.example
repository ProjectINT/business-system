# Level 1 (CSV in the repository) needs none of these: `npm i && npm run dev` works without a .env.
# Names only. Real values live in .env (gitignored) and in the Vercel project settings.

# Level 2: Supabase Postgres through the Transaction pooler (IPv4, port 6543); postgres-js with prepare: false
DATABASE_URL=
# Level 2 tests: a throwaway supabase/postgres:17 container; tests that need a database skip without it
TEST_DATABASE_URL=

# Level 2, browser upload to Storage (IMPORT_PLAN.md 3). The publishable key gives no access to the app schema
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Level 2, import queue worker (IMPORT_PLAN.md 4) and column mapping proposals (IMPORT_PLAN.md 5)
IMPORT_WORKER_SECRET=
DEEPSEEK_API_KEY=
